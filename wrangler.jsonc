{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "testra",
  "account_id": "e952ff919b0cb81d1f194b7fbdb7e19e",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-08-21",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "BETTER_AUTH_URL": "https://testra.becode.com.ar",
    "ALLOW_DEMO_AUTH": "false"
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "dist"
  },
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "b689fbf61054442f949c360054aa9a69"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "testra-db",
      "database_id": "ae7e096e-1601-4d56-bee1-718d277ef4fb",
      "migrations_dir": "drizzle"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "EXAM_RUNS",
        "class_name": "ExamRunDO"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["ExamRunDO"]
    }
  ],
  "observability": {
    "enabled": true
  }
}
