---
// Todo el `<head>` que le hablan a un buscador o a una previsualización vive
// acá, en un solo lugar, para que ninguna página quede a medias.
//
// Lo importante: NO recibe un `noindex` por parámetro. Si cada página tuviera
// que acordarse de pedirlo, la que se olvide filtra. La decisión sale de
// `PUBLIC_ROUTES`, así que una página nueva es privada hasta que alguien la
// agregue a esa lista a mano. Fallar cerrado.

import { isPublicRoute, normalizePath, publicUrl } from "@/server/site";

interface Props {
  title: string;
  description: string;
  /** Imagen social propia. Por omisión, la tarjeta de marca. */
  image?: string;
}

const { title, description, image = "/og.png" } = Astro.props;

const path = normalizePath(Astro.url.pathname);
// La canónica se arma con la ruta sola, sin query. `/login?next=/evaluaciones`
// y `/login` son la misma página: publicarlas como dos URL distintas parte la
// relevancia entre copias y le da al buscador contenido duplicado.
const canonical = publicUrl(path);
const indexable = isPublicRoute(path);
const socialImage = publicUrl(image);
const fullTitle = `${title} · Testra`;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "Testra",
  applicationCategory: "EducationalApplication",
  operatingSystem: "Web",
  url: publicUrl("/"),
  description:
    "Plataforma para que docentes creen, tomen y corrijan exámenes y evaluaciones en línea, con una sala por código y avisos de integridad que el docente interpreta.",
  inLanguage: "es",
  offers: { "@type": "Offer", price: "0", priceCurrency: "ARS" },
};

// El buscador toma el nombre que muestra arriba de cada resultado —en vez del
// dominio pelado— de los datos `WebSite` en la home del (sub)dominio, y solo
// los lee ahí. Por eso este bloque va aparte y solo en `/`.
const websiteData = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "Testra",
  url: publicUrl("/"),
  inLanguage: "es",
};
---

<meta charset="UTF-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<meta name="theme-color" content="#0a2878" />

<title>{fullTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonical} />

{
  indexable ? (
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1" />
  ) : (
    <meta name="robots" content="noindex, nofollow" />
  )
}

<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
<link rel="icon" type="image/png" sizes="192x192" href="/icon-192.png" />
<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<meta property="og:type" content="website" />
<meta property="og:site_name" content="Testra" />
<meta property="og:locale" content="es_AR" />
<meta property="og:title" content={fullTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonical} />
<meta property="og:image" content={socialImage} />
<meta property="og:image:width" content="1200" />
<meta property="og:image:height" content="630" />
<meta property="og:image:alt" content="Testra, evaluaciones en línea para docentes" />

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={fullTitle} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={socialImage} />

{
  /* Los datos estructurados solo tienen sentido donde el buscador puede entrar.
     Declararlos en una página noindex es ruido que nadie lee. */
  indexable ? (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData).replace(/</g, "\\u003c")}
    />
  ) : null
}

{
  indexable && path === "/" ? (
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(websiteData).replace(/</g, "\\u003c")}
    />
  ) : null
}
