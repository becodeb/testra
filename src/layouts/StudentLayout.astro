---
import { Image } from "astro:assets";

import testraMark from "@/assets/testra-mark.png";
import { ProfileMenu } from "@/components/profile-menu";
import "@/styles/global.css";
import { getAuthenticatedActor } from "@/server/actors";

interface Props { title: string }
const { title } = Astro.props;
const actor = getAuthenticatedActor(Astro.locals);
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <title>{title} · Testra</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="border-b bg-paper">
      <div class="mx-auto flex h-[3.75rem] max-w-[1020px] items-center justify-between px-4 lg:px-6">
        <a href="/" class="flex items-center gap-2.5" aria-label="Testra, inicio"><span class="testra-mark" aria-hidden="true"><Image src={testraMark} alt="" width={128} quality={90} loading="eager" /></span><span class="font-bold tracking-[-.025em] text-brand-deep">Testra</span></a>
        <nav class="flex items-center gap-4 text-xs font-medium text-muted" aria-label="Navegación">
          {actor?.role === "teacher" ? <a href="/evaluaciones" class="font-semibold text-brand hover:underline">Panel docente</a> : null}
          {actor ? <a href="/rendir" class="hover:text-ink">Ingresar código</a> : null}
          <a href="/acerca" class="hover:text-ink">Acerca de</a>
          <a href="/docs/vigilancia" class="hover:text-ink">Qué se registra</a>
          {actor ? <ProfileMenu client:load name={actor.name} email={actor.email} image={actor.image} role={actor.role === "teacher" ? "Docente" : "Alumno"} /> : null}
        </nav>
      </div>
    </header>
    <slot />
    <footer class="border-t bg-paper">
      <div class="mx-auto flex max-w-[1020px] flex-wrap items-center justify-between gap-3 px-4 py-5 text-xs text-muted lg:px-6">
        <p>© {new Date().getFullYear()} Testra</p>
        <nav class="flex flex-wrap gap-x-4 gap-y-2" aria-label="Información legal">
          <a href="/acerca" class="hover:text-ink">Acerca de</a>
          <a href="/privacidad" class="hover:text-ink">Privacidad</a>
          <a href="/terminos" class="hover:text-ink">Términos</a>
        </nav>
      </div>
    </footer>
  </body>
</html>
