---
import "@/styles/global.css";

interface Props { title: string }
const { title } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#FFFFFF" />
    <title>{title} · Testra</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="border-b bg-paper">
      <div class="mx-auto flex h-[3.75rem] max-w-[1020px] items-center justify-between px-4 lg:px-6">
        <a href="/" class="flex items-center gap-2" aria-label="Testra, inicio"><span class="grid size-7 place-items-center rounded-sm border-2 border-brand text-sm font-extrabold text-brand" aria-hidden="true">T</span><span class="font-bold text-brand-deep">Testra</span></a>
        <a href="/docs/vigilancia" class="text-xs font-medium text-muted underline underline-offset-4 hover:text-ink">Qué se registra</a>
      </div>
    </header>
    <slot />
  </body>
</html>
