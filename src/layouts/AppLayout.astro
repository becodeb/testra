---
import { Image } from "astro:assets";

import testraMark from "@/assets/testra-mark.png";
import { ProfileMenu } from "@/components/profile-menu";
import "@/styles/global.css";
import { getActor, isTeacher } from "@/server/actors";
import { teacherPendingCorrectionCount } from "@/server/repository";

interface Props {
  title: string;
  active?: "evaluaciones" | "sesiones" | "correcciones" | "resultados" | "admin";
  fullBleed?: boolean;
}

const { title, active, fullBleed = false } = Astro.props;
const actor = getActor(Astro.locals, "teacher");
const correctionCount = actor && isTeacher(actor) ? await teacherPendingCorrectionCount(actor) : 0;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta
      name="description"
      content="Testra ayuda a docentes a crear, aplicar y corregir evaluaciones en línea."
    />
    <title>{title} · Testra</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="sticky top-0 z-30 border-b bg-paper" aria-label="Cabecera principal">
      <div class="mx-auto grid h-[3.75rem] max-w-[1280px] grid-cols-[1fr_auto_1fr] items-center gap-3 px-4 lg:px-6">
        <a href="/evaluaciones" class="flex shrink-0 items-center gap-2.5" aria-label="Testra, inicio">
          <span class="testra-mark" aria-hidden="true"><Image src={testraMark} alt="" width={128} quality={90} loading="eager" /></span>
          <span class="text-[1.05rem] font-bold tracking-[-.02em] text-brand-deep">Testra</span>
        </a>
        <nav aria-label="Navegación principal" class="hidden h-full items-center justify-self-center gap-1 md:flex">
          <a
            href="/evaluaciones"
            aria-current={active === "evaluaciones" ? "page" : undefined}
            class:list={[
              "relative flex h-full items-center px-3 text-sm font-medium text-ink-2 hover:text-ink",
              active === "evaluaciones" && "font-semibold text-brand after:absolute after:inset-x-3 after:bottom-0 after:h-0.5 after:bg-brand",
            ]}
          >Evaluaciones</a>
          <a
            href="/sesiones"
            aria-current={active === "sesiones" ? "page" : undefined}
            class:list={[
              "relative flex h-full items-center px-3 text-sm font-medium text-ink-2 hover:text-ink",
              active === "sesiones" && "font-semibold text-brand after:absolute after:inset-x-3 after:bottom-0 after:h-0.5 after:bg-brand",
            ]}
          >Sesiones</a>
          <a
            href="/correcciones"
            aria-current={active === "correcciones" ? "page" : undefined}
            class:list={["relative flex h-full items-center gap-2 px-3 text-sm font-medium text-ink-2 hover:text-ink", active === "correcciones" && "font-semibold text-brand after:absolute after:inset-x-3 after:bottom-0 after:h-0.5 after:bg-brand"]}
          >Correcciones{correctionCount ? <span class="mono-number rounded-full bg-brand px-1.5 py-0.5 text-[.65rem] font-bold text-white" aria-label={`${correctionCount} pendientes`}>{correctionCount > 99 ? "99+" : correctionCount}</span> : null}</a>
          <a
            href="/resultados"
            aria-current={active === "resultados" ? "page" : undefined}
            class:list={[
              "relative flex h-full items-center px-3 text-sm font-medium text-ink-2 hover:text-ink",
              active === "resultados" && "font-semibold text-brand after:absolute after:inset-x-3 after:bottom-0 after:h-0.5 after:bg-brand",
            ]}
          >Resultados</a>
          {actor?.superadmin ? <a href="/admin" aria-current={active === "admin" ? "page" : undefined} class:list={["relative flex h-full items-center px-3 text-sm font-medium text-ink-2 hover:text-ink", active === "admin" && "font-semibold text-brand after:absolute after:inset-x-3 after:bottom-0 after:h-0.5 after:bg-brand"]}>Consola</a> : null}
        </nav>
        <div class="col-start-3 flex items-center justify-self-end">{Astro.locals.user && actor ? <ProfileMenu client:load name={actor.name} email={actor.email} image={actor.image} role={actor.role === "teacher" ? "Docente" : "Alumno"} /> : <span class="text-xs text-muted">Demo local</span>}</div>
      </div>
      <nav aria-label="Navegación principal móvil" class="nav-secciones mx-auto max-w-[1280px] overflow-x-auto border-t px-3 md:hidden"><div class="mx-auto flex w-max">
        <a href="/evaluaciones" aria-current={active === "evaluaciones" ? "page" : undefined} class:list={["min-h-10 shrink-0 px-2.5 py-2.5 text-sm font-medium text-ink-2", active === "evaluaciones" && "border-b-2 border-brand font-semibold text-brand"]}>Evaluaciones</a>
        <a href="/sesiones" aria-current={active === "sesiones" ? "page" : undefined} class:list={["min-h-10 shrink-0 px-2.5 py-2.5 text-sm font-medium text-ink-2", active === "sesiones" && "border-b-2 border-brand font-semibold text-brand"]}>Sesiones</a>
        <a href="/correcciones" aria-current={active === "correcciones" ? "page" : undefined} class:list={["min-h-10 shrink-0 px-2.5 py-2.5 text-sm font-medium text-ink-2", active === "correcciones" && "border-b-2 border-brand font-semibold text-brand"]}>Correcciones{correctionCount ? ` (${correctionCount})` : ""}</a>
        <a href="/resultados" aria-current={active === "resultados" ? "page" : undefined} class:list={["min-h-10 shrink-0 px-2.5 py-2.5 text-sm font-medium text-ink-2", active === "resultados" && "border-b-2 border-brand font-semibold text-brand"]}>Resultados</a>
              {actor?.superadmin ? <a href="/admin" aria-current={active === "admin" ? "page" : undefined} class:list={["min-h-10 shrink-0 px-2.5 py-2.5 text-sm font-medium text-ink-2", active === "admin" && "border-b-2 border-brand font-semibold text-brand"]}>Consola</a> : null}
      </div></nav>
    </header>
    {fullBleed ? <slot /> : <main id="contenido" class="page-content mx-auto w-full max-w-[1280px] px-4 py-7 lg:px-6"><slot /></main>}
  </body>
</html>
