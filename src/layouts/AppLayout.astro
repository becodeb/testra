---
import { Image } from "astro:assets";

import testraMark from "@/assets/testra-mark.png";
import { SignOutButton } from "@/components/sign-out-button";
import "@/styles/global.css";
import { getActor } from "@/server/actors";

interface Props {
  title: string;
  active?: "evaluaciones" | "sesiones" | "resultados" | "solicitudes" | "admin";
  fullBleed?: boolean;
}

const { title, active, fullBleed = false } = Astro.props;
const actor = getActor(Astro.locals, "teacher");
const initials = actor?.name.split(/\s+/).map((part) => part[0]).join("").slice(0, 2).toUpperCase() ?? "T";
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="theme-color" content="#FFFFFF" />
    <link rel="icon" type="image/png" href="/favicon.png" />
    <meta
      name="description"
      content="Testra ayuda a docentes a crear, aplicar y corregir evaluaciones en línea."
    />
    <title>{title} · Testra</title>
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <header class="sticky top-0 z-30 border-b bg-paper" aria-label="Cabecera principal">
      <div class="mx-auto grid h-[3.75rem] max-w-[1280px] grid-cols-[1fr_auto_1fr] items-center gap-3 px-4 lg:px-6">
        <a href="/evaluaciones" class="flex shrink-0 items-center gap-2.5" aria-label="Testra, inicio">
          <span class="testra-mark" aria-hidden="true"><Image src={testraMark} alt="" width={128} quality={90} loading="eager" /></span>
          <span class="text-[1.05rem] font-bold tracking-[-.02em] text-brand-deep">Testra</span>
        </a>
        <nav aria-label="Navegación principal" class="hidden h-full items-center justify-self-center gap-1 md:flex">
          <a
            href="/evaluaciones"
            aria-current={active === "evaluaciones" ? "page" : undefined}
            class:list={[
              "relative flex h-full items-center px-3 text-sm font-medium text-ink-2 hover:text-ink",
              active === "evaluaciones" && "font-semibold text-brand after:absolute after:inset-x-3 after:bottom-0 after:h-0.5 after:bg-brand",
            ]}
          >Evaluaciones</a>
          <a
            href="/sesiones"
            aria-current={active === "sesiones" ? "page" : undefined}
            class:list={[
              "relative flex h-full items-center px-3 text-sm font-medium text-ink-2 hover:text-ink",
              active === "sesiones" && "font-semibold text-brand after:absolute after:inset-x-3 after:bottom-0 after:h-0.5 after:bg-brand",
            ]}
          >Sesiones</a>
          <a
            href="/resultados"
            aria-current={active === "resultados" ? "page" : undefined}
            class:list={[
              "relative flex h-full items-center px-3 text-sm font-medium text-ink-2 hover:text-ink",
              active === "resultados" && "font-semibold text-brand after:absolute after:inset-x-3 after:bottom-0 after:h-0.5 after:bg-brand",
            ]}
          >Resultados</a>
          {actor?.orgAdmin ? <a href="/solicitudes" aria-current={active === "solicitudes" ? "page" : undefined} class:list={["relative flex h-full items-center px-3 text-sm font-medium text-ink-2 hover:text-ink", active === "solicitudes" && "font-semibold text-brand after:absolute after:inset-x-3 after:bottom-0 after:h-0.5 after:bg-brand"]}>Solicitudes</a> : null}
          {actor?.superadmin ? <a href="/admin" aria-current={active === "admin" ? "page" : undefined} class:list={["relative flex h-full items-center px-3 text-sm font-medium text-ink-2 hover:text-ink", active === "admin" && "font-semibold text-brand after:absolute after:inset-x-3 after:bottom-0 after:h-0.5 after:bg-brand"]}>Consola</a> : null}
        </nav>
        <div class="flex items-center justify-self-end gap-2">
          <span class="hidden text-right sm:block">
            <span class="block text-sm font-semibold text-ink">{actor?.name ?? "Testra"}</span>
            <span class="block text-xs text-muted">{actor?.role === "teacher" ? "Docente" : "Cuenta"}{!Astro.locals.user ? " · Demo local" : ""}</span>
          </span>
          <span class="grid size-8 place-items-center rounded-full bg-brand-soft text-xs font-bold text-brand" aria-hidden="true">{initials}</span>
          {Astro.locals.user ? <SignOutButton client:load /> : null}
        </div>
      </div>
      <nav aria-label="Navegación principal móvil" class="mx-auto flex max-w-[1280px] overflow-x-auto border-t px-4 md:hidden">
        <a href="/evaluaciones" aria-current={active === "evaluaciones" ? "page" : undefined} class:list={["min-h-10 shrink-0 px-3 py-2.5 text-sm font-medium text-ink-2", active === "evaluaciones" && "border-b-2 border-brand font-semibold text-brand"]}>Evaluaciones</a>
        <a href="/sesiones" aria-current={active === "sesiones" ? "page" : undefined} class:list={["min-h-10 shrink-0 px-3 py-2.5 text-sm font-medium text-ink-2", active === "sesiones" && "border-b-2 border-brand font-semibold text-brand"]}>Sesiones</a>
        <a href="/resultados" aria-current={active === "resultados" ? "page" : undefined} class:list={["min-h-10 shrink-0 px-3 py-2.5 text-sm font-medium text-ink-2", active === "resultados" && "border-b-2 border-brand font-semibold text-brand"]}>Resultados</a>
        {actor?.orgAdmin ? <a href="/solicitudes" aria-current={active === "solicitudes" ? "page" : undefined} class:list={["min-h-10 shrink-0 px-3 py-2.5 text-sm font-medium text-ink-2", active === "solicitudes" && "border-b-2 border-brand font-semibold text-brand"]}>Solicitudes</a> : null}
              {actor?.superadmin ? <a href="/admin" aria-current={active === "admin" ? "page" : undefined} class:list={["min-h-10 shrink-0 px-3 py-2.5 text-sm font-medium text-ink-2", active === "admin" && "border-b-2 border-brand font-semibold text-brand"]}>Consola</a> : null}
</nav>
    </header>
    {fullBleed ? <slot /> : <main id="contenido" class="page-content mx-auto w-full max-w-[1280px] px-4 py-7 lg:px-6"><slot /></main>}
  </body>
</html>
