---
import { StudentRuntime } from "@/components/student-runtime";
import { JoinRun } from "@/components/join-run";
import StudentLayout from "@/layouts/StudentLayout.astro";
import { getAuthenticatedActor } from "@/server/actors";
import { getJoinableRun, getStudentSession } from "@/server/repository";

const actor = getAuthenticatedActor(Astro.locals);
const code = Astro.params.code!.trim().toUpperCase();
const session = await getStudentSession({ actor, request: Astro.request }, code);
const run = session?.run ?? await getJoinableRun(code);
if (!run) return new Response("No encontramos una evaluación activa con ese código", { status: 404 });
const monitored = [
  run.detect_focus_loss ? "cambios de pestaña o ventana" : null,
  "interrupciones de conexión",
  run.block_clipboard ? "acciones de copiar o pegar (solo la cantidad de caracteres cuando está disponible)" : null,
  run.require_fullscreen ? "salidas de pantalla completa" : null,
].filter(Boolean).join(", ");
---

<StudentLayout title={run.title}>
  {session ? (
    <StudentRuntime
      client:load
      runId={session.run.id}
      code={session.run.code}
      title={session.run.title}
      participantId={session.participant.id}
      studentName={session.participant.display_name}
      questions={session.questions}
      initialAnswers={session.answers}
      initialStatus={session.run.status}
      participantStatus={session.participant.status}
      serverNow={Date.now()}
      endsAt={session.run.ends_at}
      allowBackwards={Boolean(session.run.allow_backwards)}
      showProgress={Boolean(session.run.show_progress)}
      autoSubmit={Boolean(session.run.auto_submit)}
      allowReconnect={Boolean(session.run.allow_reconnect)}
      requireFullscreen={Boolean(session.run.require_fullscreen)}
      detectFocusLoss={Boolean(session.run.detect_focus_loss)}
      blockClipboard={Boolean(session.run.block_clipboard)}
      violationAction={session.run.violation_action}
    />
  ) : (
    <main id="contenido" class="mx-auto grid min-h-[calc(100dvh-3.75rem)] max-w-lg place-items-center px-4 py-12">
      <JoinRun client:load step="name" code={run.code} runTitle={run.title} defaultName={actor?.name ?? ""} defaultEmail={actor?.email ?? ""} requiresClassroomEmail={Boolean(run.classroom_course_id && run.classroom_coursework_id)} monitoringSummary={monitored} />
    </main>
  )}
</StudentLayout>
