---
import { JoinRun } from "@/components/join-run";
import StudentLayout from "@/layouts/StudentLayout.astro";
import { getActor } from "@/server/actors";

const actor = getActor(Astro.locals, "student");
if (!actor) return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
---

<StudentLayout title="Ingresar a una evaluación">
  <main id="contenido" class="mx-auto grid min-h-[calc(100dvh-3.75rem)] max-w-lg place-items-center px-4 py-12">
    <JoinRun client:load />
  </main>
</StudentLayout>
