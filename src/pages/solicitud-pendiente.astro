---
import StudentLayout from "@/layouts/StudentLayout.astro";
if (!Astro.locals.user) return Astro.redirect("/login");
---
<StudentLayout title="Solicitud enviada"><main id="contenido" class="mx-auto grid min-h-[calc(100dvh-3.75rem)] max-w-xl place-items-center px-4 py-12"><section class="w-full rounded-xl border bg-paper p-8 shadow-card"><p class="text-xs font-bold tracking-[.1em] text-brand uppercase">Acceso solicitado</p><h1 class="mt-3 text-2xl font-semibold text-ink">Tu solicitud llegó al administrador</h1><p class="mt-3 text-sm leading-6 text-muted">La institución asociada a tu dominio ya tiene un espacio en Testra. Un administrador podrá aprobarte desde su panel. Cuando lo haga, volvé a entrar y vas a ver tus evaluaciones.</p><a href="/rendir" class="mt-6 inline-flex h-10 items-center rounded-md bg-brand px-4 text-sm font-semibold text-white">Mientras tanto, ingresar un código</a></section></main></StudentLayout>
