---
import AppLayout from "@/layouts/AppLayout.astro";
import { getActor, isTeacher } from "@/server/actors";
import { listRuns } from "@/server/repository";

const actor = getActor(Astro.locals, "teacher");
if (!actor) return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
if (!isTeacher(actor)) return Astro.redirect("/rendir");
const runs = await listRuns(actor);
const formatter = new Intl.DateTimeFormat("es-AR", { dateStyle: "medium", timeStyle: "short" });
---

<AppLayout title="Tomas" active="tomas">
  <section class="flex flex-col gap-6" aria-labelledby="page-title">
    <div>
      <p class="mb-1 text-xs font-semibold tracking-[.08em] text-muted uppercase">Historial</p>
      <h1 id="page-title" class="text-2xl font-semibold tracking-[-.02em] text-ink">Tomas</h1>
      <p class="mt-1 text-sm text-muted">Cada fila conserva la copia exacta de las preguntas que rindió el curso.</p>
    </div>
    <div class="overflow-x-auto rounded-lg border bg-paper shadow-card">
      <table class="w-full min-w-[800px] border-collapse text-left text-sm">
        <caption class="sr-only">Historial de tomas de evaluaciones</caption>
        <thead class="bg-inset text-xs font-semibold text-ink-2"><tr><th class="px-4 py-3">Evaluación</th><th class="px-4 py-3">Código</th><th class="px-4 py-3">Fecha</th><th class="px-4 py-3">Estado</th><th class="px-4 py-3 text-right">Rindieron</th><th class="px-4 py-3 text-right">Puntaje promedio</th><th class="px-4 py-3 text-right">Incidentes</th></tr></thead>
        <tbody class="divide-y">
          {runs.map((run) => <tr class="hover:bg-canvas"><th scope="row" class="px-4 py-3 font-medium text-ink"><a href={`/tomas/${run.id}`} class="hover:text-brand hover:underline">{run.title}</a></th><td class="mono-number px-4 py-3 text-brand">{run.code}</td><td class="tabular px-4 py-3 text-ink-2">{formatter.format(run.createdAt)}</td><td class="px-4 py-3"><span class="rounded-sm border px-1.5 py-0.5 text-xs font-semibold">{run.status === "lobby" ? "Sala" : run.status === "running" ? "En curso" : "Finalizada"}</span></td><td class="mono-number px-4 py-3 text-right">{run.participantCount}</td><td class="mono-number px-4 py-3 text-right">{run.average === null ? "—" : run.average.toLocaleString("es-AR", { maximumFractionDigits: 1 })}</td><td class="mono-number px-4 py-3 text-right text-warn">{run.incidentCount}</td></tr>)}
          {!runs.length ? <tr><td colspan="7" class="px-4 py-12 text-center text-muted">Todavía no creaste ninguna toma.</td></tr> : null}
        </tbody>
      </table>
    </div>
  </section>
</AppLayout>
