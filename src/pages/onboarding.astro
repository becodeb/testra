---
import { OnboardingForm } from "@/components/onboarding-form";
import StudentLayout from "@/layouts/StudentLayout.astro";

if (!Astro.locals.user) return Astro.redirect("/login?next=/onboarding");
---

<StudentLayout title="Configurar cuenta"><main id="contenido" class="mx-auto grid min-h-[calc(100dvh-3.75rem)] max-w-lg place-items-center px-4 py-12"><OnboardingForm client:load /></main></StudentLayout>
