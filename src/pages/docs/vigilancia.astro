---
import StudentLayout from "@/layouts/StudentLayout.astro";
const signals = [
  { title: "Cambio de pestaña o ventana", weight: "Contexto medio", benign: "Una notificación, un popup de permisos, el selector de archivos o una ventana del sistema pueden ocultar Testra brevemente.", concerning: "Ausencias largas o repetidas pueden corresponder a otra pestaña, otra ventana, una aplicación o incluso otro escritorio virtual." },
  { title: "Ventana sin foco", weight: "Contexto leve", benign: "Puede ocurrir al tocar la barra de direcciones, una extensión, un aviso del navegador, el centro de notificaciones o un mensaje emergente.", concerning: "Repeticiones sostenidas, especialmente en las mismas preguntas, merecen revisar la secuencia completa." },
  { title: "Copiar, cortar o pegar", weight: "Según configuración", benign: "Puede ser una herramienta de accesibilidad o una edición accidental. Testra registra la acción y cantidad de caracteres, nunca el texto.", concerning: "Pegados grandes en respuestas de desarrollo o muchos eventos seguidos pueden justificar una conversación." },
  { title: "Salida de pantalla completa", weight: "Contexto medio", benign: "Escape, un permiso, una alerta del sistema, cambiar de monitor o una captura del sistema pueden cerrar pantalla completa.", concerning: "Salidas repetidas combinadas con pérdidas largas de foco forman un patrón más relevante." },
  { title: "Desconexión", weight: "Contexto leve", benign: "Wi‑Fi inestable, ahorro de batería, suspensión, datos móviles o el navegador pausando una pestaña.", concerning: "Desconexiones reiteradas en momentos concretos pueden requerir revisar cómo continuó la sesión." },
  { title: "Otra sesión, red o navegador", weight: "Evidencia débil aislada", benign: "Recargar, restaurar una pestaña, pasar de Wi‑Fi a datos, VPN, actualización del navegador o modo incógnito pueden explicarlo.", concerning: "Dos sesiones simultáneas reales o cambios repetidos junto con otros eventos son más relevantes que una señal sola." },
  { title: "Ritmo de resolución", weight: "Contexto, no integridad", benign: "Preguntas simples, respuestas ya preparadas o una persona que escribe rápido pueden explicar un ritmo alto.", concerning: "Testra sólo lo conserva como contexto cuando hay varios desarrollos extensos distintos en poco tiempo; nunca se usa como prueba de copia." },
];
---
<StudentLayout title="Qué significa cada aviso"><main id="contenido" class="bg-canvas"><section class="mx-auto max-w-5xl px-4 py-12 lg:px-6"><header class="max-w-3xl"><p class="text-xs font-bold tracking-[.12em] text-brand uppercase">Transparencia, sin falsas certezas</p><h1 class="mt-3 text-4xl font-semibold tracking-[-.04em] text-ink">Qué puede significar cada aviso</h1><p class="mt-4 text-lg leading-8 text-ink-2">Un aviso describe algo que el navegador observó. No demuestra que alguien se copió. La duración, la pregunta activa, la repetición y la combinación con otras señales son lo que le da contexto.</p></header><div class="mt-10 grid gap-4 md:grid-cols-2">{signals.map((signal) => <article class="rounded-xl border bg-paper p-6 shadow-card"><div class="flex items-start justify-between gap-3"><h2 class="text-lg font-semibold text-ink">{signal.title}</h2><span class="shrink-0 rounded-full bg-inset px-2.5 py-1 text-[.68rem] font-bold tracking-wide text-muted uppercase">{signal.weight}</span></div><div class="mt-5 grid gap-4"><div class="border-l-2 border-ok pl-4"><h3 class="text-xs font-bold tracking-[.08em] text-ok uppercase">Puede ser accidental</h3><p class="mt-1 text-sm leading-6 text-ink-2">{signal.benign}</p></div><div class="border-l-2 border-warn pl-4"><h3 class="text-xs font-bold tracking-[.08em] text-warn uppercase">Cuándo mirar más de cerca</h3><p class="mt-1 text-sm leading-6 text-ink-2">{signal.concerning}</p></div></div></article>)}</div><section class="mt-8 grid gap-5 rounded-xl bg-brand-deep p-7 text-white md:grid-cols-[1fr_1.4fr]"><div><p class="text-xs font-bold tracking-[.1em] text-cyan-200 uppercase">Cómo se interpreta bien</p><h2 class="mt-2 text-2xl font-semibold">La secuencia importa más que un contador.</h2></div><ol class="grid gap-3 text-sm leading-6 text-blue-50"><li><strong>1. Pregunta:</strong> cada aviso nuevo queda asociado a la pregunta que el alumno estaba viendo.</li><li><strong>2. Duración:</strong> una pérdida de foco de una fracción de segundo no equivale a varios minutos.</li><li><strong>3. Patrón:</strong> se revisan repetición, respuestas y demás eventos; nunca una señal aislada.</li><li><strong>4. Decisión humana:</strong> el reporte de IA es orientativo. El docente conserva la revisión y la decisión final.</li></ol></section><section class="mt-8 rounded-xl border bg-paper p-6"><h2 class="text-lg font-semibold text-ink">Lo que Testra no registra</h2><p class="mt-2 text-sm leading-6 text-ink-2">No usa cámara ni micrófono, no captura pantalla, no guarda teclas ni contenido del portapapeles y no lee otras pestañas. Solo recibe eventos limitados que el navegador permite observar dentro de la evaluación.</p></section></section></main></StudentLayout>
