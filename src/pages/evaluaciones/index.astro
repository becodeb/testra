---
import { ExamLibrary } from "@/components/exam-library";
import AppLayout from "@/layouts/AppLayout.astro";
import { getActor, isTeacher } from "@/server/actors";
import { listExams, listSubjects } from "@/server/repository";

const actor = getActor(Astro.locals, "teacher");
if (!actor) return Astro.redirect(`/login?next=${encodeURIComponent(Astro.url.pathname)}`);
if (!isTeacher(actor)) return Astro.redirect("/rendir");
const [exams, subjects] = await Promise.all([listExams(actor), listSubjects(actor)]);
---

<AppLayout title="Evaluaciones" active="evaluaciones">
  <section class="flex flex-col gap-6" aria-labelledby="page-title">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <div>
        <p class="mb-1 text-xs font-semibold tracking-[.08em] text-muted uppercase">Panel docente</p>
        <h1 id="page-title" class="text-2xl font-semibold tracking-[-.02em] text-ink">Evaluaciones</h1>
        <p class="mt-1 text-sm text-muted">Creá una evaluación o volvé a usar una anterior.</p>
      </div>
      <a href="/evaluaciones/nueva" class="inline-flex h-9 items-center justify-center rounded-md bg-brand px-4 text-sm font-semibold text-white shadow-card transition-colors hover:bg-brand-deep focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-brand">Nueva evaluación</a>
    </div>
    <aside class="flex flex-wrap items-center justify-between gap-3 rounded-lg border border-brand/20 bg-brand-soft/40 px-4 py-3"><div><p class="text-sm font-semibold text-brand-deep">¿Trabajás con Google Classroom?</p><p class="mt-0.5 text-xs text-ink-2">Podés publicar la tarea y cargar el padrón desde cada sala. La integración es opcional.</p></div><a href="/sesiones" class="text-sm font-semibold text-brand hover:underline">Ver salas y Classroom →</a></aside>
    <ExamLibrary client:load initialExams={exams} subjects={subjects} />
  </section>
</AppLayout>
