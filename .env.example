# Postgres. En Coolify apuntá al servicio de la base dentro de la misma red.
DATABASE_URL=postgres://testra:testra@127.0.0.1:5432/testra
DATABASE_POOL_MAX=12

# Dominio público con el que se firman y validan las sesiones.
BETTER_AUTH_URL=http://127.0.0.1:4321
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters

# Opcionales hasta habilitar Google OAuth / Classroom.
GOOGLE_CLIENT_ID=replace-me.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-me

# Corrección, informes y variantes con IA, vía el AI Router de BeCode. Su cascada
# gratuita no pide credenciales, así que no hace falta definir nada: dejá la
# variable comentada. Definirla vacía apaga toda la IA de la app.
# AI_ROUTER_URL=https://ai-router.becode.com.ar

# Detección de copia entre alumnos con Jev (TypeSafe AI), vía Vercel AI Gateway.
# Sin esta clave la comparación entre alumnos sigue mostrando las señales de
# código; solo la parte semántica no corre.
# AI_GATEWAY_API_KEY=
# AI_GATEWAY_URL=https://ai-gateway.vercel.sh

# Solo para desarrollo: habilita los actores de demostración sin iniciar sesión.
ALLOW_DEMO_AUTH=true

# Ven la plataforma entera (/admin): todas las evaluaciones y salas abiertas.
# Separados por coma. Se resuelve por correo, asi que se
# puede dar de alta a alguien antes de que se registre.
SUPERADMIN_EMAILS=

# Solo para el servidor de producción (server.mjs).
PORT=3000
HOST=0.0.0.0
