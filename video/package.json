{
  "name": "testra-demo-video",
  "private": true,
  "type": "module",
  "description": "Renders the Testra demo video. Uses the repo root node_modules (run npm ci at the root first).",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "build": "vite build --config vite.config.mjs",
    "stills": "node tools/still.mjs 0.6 4.2 8.4 14.3 18.6 20.6 27.0 30.0 33.9 36.2 39.0",
    "music": "node audio/compose.mjs && node audio/onsets.mjs",
    "selftest": "node tools/render.mjs --selftest",
    "render:draft": "node tools/render.mjs --scale 1 --out out/testra-demo-draft.mp4",
    "render:final": "node tools/render.mjs --scale 2 --out out/testra-demo.mp4",
    "concat": "node tools/concat.mjs"
  }
}
